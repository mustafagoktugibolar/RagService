RAG__EMBEDDINGPROVIDER=OpenAI
RAG__EMBEDDINGMODEL=text-embedding-3-small
RAG__VECTORSTOREPROVIDER=Qdrant
RAG__STORAGEPROVIDER=S3
RAG__VECTORSIZE=1536
RAG__DEFAULTTOPK=5

OPENAI__APIKEY=
OPENAI__ORGANIZATION=
OPENAI__PROJECT=
OPENAI__DIMENSIONS=

AZUREOPENAI__ENDPOINT=
AZUREOPENAI__APIKEY=
AZUREOPENAI__DEPLOYMENT=
AZUREOPENAI__DIMENSIONS=

QDRANT__HOST=qdrant
QDRANT__PORT=6334
QDRANT__HTTPPORT=6333
QDRANT__HTTPS=false
QDRANT__APIKEY=
QDRANT__TIMEOUTSECONDS=30
QDRANT__METADATACOLLECTION=rag_collection_metadata

PGVECTOR__CONNECTIONSTRING=Host=postgres;Port=5432;Database=rag;Username=rag;Password=rag
PGVECTOR__TABLENAME=rag_vectors
PGVECTOR__METADATATABLENAME=rag_collection_metadata

# Any S3-compatible store (SeaweedFS by default; MinIO, Ceph, R2, AWS S3 work by changing these values).
# The same ACCESSKEY/SECRETKEY are used by compose to create the bundled SeaweedFS credentials.
S3__SERVICEURL=http://seaweedfs:8333
S3__REGION=us-east-1
S3__ACCESSKEY=ragaccess
S3__SECRETKEY=ragsecret
S3__FORCEPATHSTYLE=true
S3__BUCKET=rag-documents

REDIS__CONNECTIONSTRING=redis:6379


CHUNKING__CHUNKSIZE=1000
CHUNKING__CHUNKOVERLAP=200

QUERYCACHE__ENABLED=false
QUERYCACHE__TTLMINUTES=5

SEEDER__COLLECTION=wikipedia
SEEDER__MAXDOCUMENTS=0
SEEDER__INDEXQUEUENAME=rag.index

OPENTELEMETRY__OTLPENDPOINT=http://tempo:4317

EMBEDDINGCACHE__ENABLED=true
EMBEDDINGCACHE__TTLHOURS=720

# --- Retrieval strategy and optional reranking -------------------------------------------------------------
# Production default: dense retrieval, NO reranking. Changing either is an explicit, evaluated decision (docs/adr, docs/eval).
RETRIEVAL__STRATEGY=Dense
RETRIEVAL__RERANKING__ENABLED=false
# Provider used only when ENABLED=true: None | OpenAiDecisions | Jev | Onnx.
# WARNING: with a hosted provider (OpenAiDecisions, Jev) the query text AND the candidate passages are sent to that provider.
RETRIEVAL__RERANKING__PROVIDER=OpenAiDecisions
RETRIEVAL__RERANKING__CANDIDATEBUDGET=20
RETRIEVAL__RERANKING__TIMEOUTSECONDS=15
# Fallback: serve un-reranked results on provider failure (default). Fail: fail the query instead.
RETRIEVAL__RERANKING__FAILUREPOLICY=Fallback
# OpenAI Decisions reuses OPENAI__APIKEY above; its model defaults to gpt-6-luna.
# OPENAIDECISIONS__MODEL=gpt-6-luna
# Jev needs its OWN key (the OpenAI key does not work there). Leave empty unless RERANKING__PROVIDER=Jev.
JEV__APIKEY=
# Pin a version for production; "jev-latest" is an alias that can change underneath you.
# JEV__MODEL=jev-latest
