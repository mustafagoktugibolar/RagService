{
  "Rag": {
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "VectorStoreProvider": "Qdrant",
    "StorageProvider": "S3",
    "VectorSize": 1536,
    "DefaultTopK": 5
  },
  "OpenAI": {
    "ApiKey": "",
    "Organization": null,
    "Project": null,
    "Dimensions": null
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "Deployment": "",
    "Dimensions": null
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "HttpPort": 6333,
    "Https": false,
    "ApiKey": null,
    "TimeoutSeconds": 30,
    "MetadataCollection": "rag_collection_metadata"
  },
  "S3": {
    "ServiceUrl": "http://localhost:8333",
    "Region": "us-east-1",
    "AccessKey": "ragaccess",
    "SecretKey": "ragsecret",
    "ForcePathStyle": true,
    "Bucket": "rag-documents"
  },
  "Chunking": {
    "ChunkSize": 1000,
    "ChunkOverlap": 200
  },
  "QueryCache": {
    "Enabled": false,
    "TtlMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
