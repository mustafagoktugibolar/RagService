{
  "Rag": {
    "StorageProvider": "S3"
  },
  "S3": {
    "ServiceUrl": "http://localhost:8333",
    "Region": "us-east-1",
    "AccessKey": "ragaccess",
    "SecretKey": "ragsecret",
    "ForcePathStyle": true,
    "Bucket": "rag-documents"
  },
  "RabbitMQ": {
    "HostName": "kubernetes.docker.internal",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "rag.index",
    "ConnectionRetryDelaySeconds": 5
  },
  "HuggingFace": {
    "Dataset": "rag-datasets/rag-mini-wikipedia",
    "Config": "text-corpus",
    "Split": "passages",
    "BatchSize": 100
  },
  "Seeder": {
    "Collection": "wikipedia",
    "MaxDocuments": 0,
    "IndexQueueName": "rag.index"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
